{
  "name": "sili-sudoku",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "description": "A generic constraint runtime for Sudoku and variant-Sudoku puzzles. Puzzle types are definitions, not engine features.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc -b --noEmit",
    "deps": "node scripts/node_support.ts && npm audit --omit=dev && (npm outdated || true)"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "lz-string": "^1.5.0",
    "pako": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.1.4"
  }
}
